// 	burst-transfer = <256>;
// };

&usbfs {
	interrupts = <32 12>, <33 12>;
	interrupt-names = "usbfs-i", "usbfs-r";
	status = "okay";

	zephyr_udc0: udc {
		status = "okay";
	};
};

&code_mram_cm85 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x0 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x10000 DT_SIZE_K(344)>;
		};

		slot1_partition: partition@66000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x66000 DT_SIZE_K(344)>;
		};

		storage_partition: partition@bc000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0xbc000 DT_SIZE_K(16)>;
		};
	};
};

// &mipi_dsi {
// 	interrupts = <24 12>, <25 12>, <26 12>, <27 12>, <28 12>, <29 12>;
// 	interrupt-names = "sq0", "sq1", "vm", "rcv", "ferr", "ppi";
// };

&lcdif {
	interrupts = <30 1>;
	interrupt-names = "line";
};

&drw {
	interrupt-names = "drw";
	interrupts = <31 12>;
	status = "okay";
};

zephyr_lcdif: &lcdif {};

zephyr_mipi_dsi: &mipi_dsi {};

renesas_mipi_i2c: &iic1 {};

&sdhc0 {	
	interrupt-names = "accs", "card", "dma-req";
	interrupts = <84 12>, <85 12>, <86 12>;
	pinctrl-0 = <&sdhc0_default>;
	pinctrl-names = "default";
	status = "okay";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

&sdhc1 {	
	interrupt-names = "accs", "card", "dma-req";
	interrupts = <81 12>, <82 12>, <83 12>;
	pinctrl-0 = <&sdhc1_default>;
	pinctrl-names = "default";
	status = "okay";

	airoc-wifi {
		status = "okay";
		compatible = "infineon,airoc-wifi";

		/* Wi-Fi control gpios */
		wifi-reg-on-gpios    = <&ioport4 4 GPIO_ACTIVE_HIGH >;
		wifi-host-wake-gpios = <&ioport5 14 GPIO_ACTIVE_HIGH>;
    };
};

arducam_ffc_40pin_i2c: &iic1 {};

arducam_ffc_40pin_dvp_interface: &ceu {};

// arducam_ffc_40pin_dvp_xclk: &cam_clock {};

&eswm {
	interrupts = <24 1>;
	interrupt-names = "gwdi";
	status = "okay";
};

&eth0 {
	phy-connection-type = "rgmii";
	local-mac-address = [74 90 50 01 02 03];
	phy-clock-type = "xtal";
	phy-handle = <&phy2>;
	pinctrl-0 = <&eth0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&mdio0 {
	pinctrl-0 = <&mdio0_default>;
	pinctrl-names = "default";
	status = "okay";

	phy2: phy@2 {
		compatible = "realtek,rtl8211f";
		reg = <2>;
		int-gpios = <&ioportc 13 GPIO_ACTIVE_LOW>;
		reset-gpios = <&ioport8 13 GPIO_ACTIVE_HIGH>;
		realtek,rgmii-delay = "rxid";
		status = "okay";
	};
};

